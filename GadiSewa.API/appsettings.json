{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=port_number;Database=db_name;Username=db_username;Password=db_password"
  },
  "Jwt": {
    "Issuer": "GadiSewa.API",
    "Audience": "GadiSewa.Client",
    "Key": "KEY_SHOULD_BE_LONG_AND_SECURE",
    "ExpiryMinutes": 120
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromEmail": "your-email@example.com",
    "FromName": "GadiSewa",
    "Username": "your-email@example.com",
    "Password": ""
  },
  "AdminBootstrap": {
    "SetupKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
  },
  "Notifications": {
    "OverdueReminderIntervalInDays": 1
  },
  "Cors": {
    "AllowedOrigins": ["https://your-frontend-domain.com"]
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Properties": {
      "Application": "GadiSewa.API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}